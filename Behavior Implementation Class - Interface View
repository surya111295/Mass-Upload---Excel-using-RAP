CLASS lhc_zb_supplier DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.

    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      IMPORTING keys REQUEST requested_authorizations FOR zb_supplier RESULT result.

    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      IMPORTING REQUEST requested_authorizations FOR zb_supplier RESULT result.
    METHODS uploadexceldata FOR MODIFY
      IMPORTING keys FOR ACTION zb_supplier~uploadexceldata.

ENDCLASS.

CLASS lhc_zb_supplier IMPLEMENTATION.

  METHOD get_instance_authorizations.
  ENDMETHOD.

  METHOD get_global_authorizations.
    result-%create = if_abap_behv=>auth-allowed.
  ENDMETHOD.

  METHOD uploadExcelData.

  types: BEGIN OF lty_upload,
*supplier_id     TYPE zi_supplier_view-supplier_id,
            supplier_name   type zi_supplier_view-supplier_name,
            address_id      type zi_supplier_view-address_id,
            plant_id     type zi_supplier_view-plant_id,
            city         type zi_supplier_view-city,
            country      type zi_supplier_view-country,
            supplier_material  type zi_supplier_view-supplier_material,
            supplier_price     type zi_supplier_view-supplier_price,
            supplier_currency  type zi_supplier_view-supplier_currency,
        end of lty_upload.

    data lt_sheet_data type STANDARD TABLE OF lty_upload.

    types: BEGIN OF lty_local,
            supplier_name   type zi_supplier_view-supplier_name,
            plant_id     type zi_supplier_view-plant_id,
            city         type zi_supplier_view-city,
            country      type zi_supplier_view-country,
            supplier_material  type zi_supplier_view-supplier_material,
            price     type string,
        end of lty_local.

        data lt_local type STANDARD TABLE OF lty_local.


    data(ls_param) = keys[ 1 ]-%param.
    data(lv_attachment) = ls_param-_streamproperties-StreamProperty.
    data lt_listing_create type table for CREATE zi_supplier_view.


    if ls_param is initial.
        RETURN.
    endif.

    CHECK lv_attachment is not INITIAL.
    data(lo_xlsx) = xco_cp_xlsx=>document->for_file_content( iv_file_content = lv_attachment )->read_access( ).
    data(lo_worksheet) = lo_xlsx->get_workbook( )->worksheet->at_position( 1 ).

    data(lo_sel_pattern) = xco_cp_xlsx_selection=>pattern_builder->simple_from_to(
      )->from_column( xco_cp_xlsx=>coordinate->for_alphabetic_value( 'A' )  " Start reading from Column A
      )->to_column( xco_cp_xlsx=>coordinate->for_alphabetic_value( 'G' )   " End reading at Column N
      )->from_row( xco_cp_xlsx=>coordinate->for_numeric_value( 2 )    " *** Start reading from ROW 2 to skip the header ***
      )->get_pattern( ).

     lo_worksheet->select( lo_sel_pattern
                                     )->row_stream(
                                     )->operation->write_to( REF #( lt_local    )
                                     )->set_value_transformation(
                                         xco_cp_xlsx_read_access=>value_transformation->string_value
                                     )->execute( ).

   LOOP at lt_local ASSIGNING FIELD-SYMBOL(<lfs_local>).
        APPEND INITIAL LINE TO lt_sheet_data ASSIGNING
        FIELD-SYMBOL(<lfs_sheet_data>).
        if <lfs_sheet_data> is ASSIGNED.
        <lfs_sheet_data>-supplier_name = <lfs_local>-supplier_name.
        SPLIT  <lfs_local>-price at '' into data(lv_price) data(lv_currency).
        <lfs_sheet_data>-supplier_price = CONV #( lv_price ).
        <lfs_sheet_data>-supplier_currency = CONV #( lv_currency ).
        <lfs_sheet_data>-plant_id = <lfs_local>-plant_id.
        <lfs_sheet_data>-supplier_material = <lfs_local>-supplier_material.
        <lfs_sheet_data>-city = <lfs_local>-city.
        <lfs_sheet_data>-country = <lfs_local>-country.
        endif.
   ENDLOOP.

    lt_listing_create = CORRESPONDING #( lt_sheet_data ).


   MODIFY ENTITIES OF zi_supplier_view IN LOCAL MODE
           ENTITY zb_supplier
           CREATE AUTO FILL CID FIELDS ( supplier_name
                                         address_id
                                         plant_id
                                         city
                                         country
                                         supplier_material
                                         supplier_price
                                         supplier_currency )
           WITH lt_listing_create
           " TODO: variable is assigned but never used (ABAP cleaner)
           MAPPED DATA(lt_mapped)
           " TODO: variable is assigned but never used (ABAP cleaner)
           REPORTED DATA(lt_reported)
           " TODO: variable is assigned but never used (ABAP cleaner)
           FAILED DATA(lt_failed).


    " Communicate the messages to UI - not in scope of this demo
    IF lt_failed IS INITIAL.
      APPEND VALUE #( %msg = new_message_with_text( severity = if_abap_behv_message=>severity-success
                                                    text     = 'Listings have been uploaded - please refresh the list!!' ) )
             TO reported-zb_supplier.
     else.

    ENDIF.



  ENDMETHOD.

ENDCLASS.
